# ===== 数据库 =====
DB_NAME=node_koa
DB_USER=root
DB_PASSWORD=你的数据库密码
# 本机 MySQL 若开了 skip_name_resolve，TCP 连接请写 127.0.0.1 而不是 localhost
DB_HOST=127.0.0.1
DB_PORT=3306

# ===== JWT =====
# 生产环境必填，未配置时服务会直接拒绝启动
JWT_SECRET=换成你的随机密钥
JWT_EXPIRES=2h
# 签发者标识（iss）：校验时强制匹配，防止其他系统的 Token 串用到本系统
JWT_ISSUER=rbac-admin-system

# ===== 日志 =====
# debug | info | warn | error
LOG_LEVEL=info
# LOG_FILE=false 可关闭日志写文件
LOG_DIR=logs
